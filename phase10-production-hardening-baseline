railway_variables_required:
  - PORT (Railway-provided automatically)
  - RSOS_PUBLIC_ORIGIN (your Railway https URL)
  - RSOS_DATA_DIR (path to Railway persistent volume mount)
  - RSOS_ADMIN_USERNAME (admin email, first boot only)
  - RSOS_ADMIN_PASSWORD (strong password, first boot only)
railway_variables_recommended:
  - RSOS_BACKUP_DIR (path inside or adjacent to volume for backups)
  - RSOS_OPERATOR_TOKEN (for /api/operator/health access)
  - RSOS_BACKUP_RETENTION_DAYS (backup pruning policy)
  - NODE_ENV=production
railway_variables_development_only:
  - RSOS_FRONTEND_HOST
  - RSOS_FRONTEND_PORT
  - RSOS_DEV_API_PROXY_TARGET
railway_variables_optional:
  - RSOS_BIND_HOST (defaults to 127.0.0.1, safe)
  - RSOS_ALLOW_PUBLIC_BIND (only if using external reverse proxy on same host)
  - RSOS_ALLOWED_ORIGINS (comma-separated if multiple origins)
  - RSOS_REQUIRE_ABSOLUTE_API_BASE
railway_volume_required: YES
railway_volume_mount_path: mount at e.g. /data/rsos and set RSOS_DATA_DIR=/data/rsos
