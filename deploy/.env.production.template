# RSOS secure production deployment template
NODE_ENV=production

# Public HTTPS origin served to end users
RSOS_PUBLIC_ORIGIN=https://your-rsos-domain.example

# Secure gateway ports
RSOS_HTTPS_PORT=443
RSOS_HTTP_REDIRECT_PORT=80

# Internal backend binding for proxy-only access
RSOS_INTERNAL_API_PORT=3001
RSOS_BIND_HOST=127.0.0.1

# Persistent storage
RSOS_DATA_DIR=/var/lib/rsos/data
RSOS_BACKUP_DIR=/var/lib/rsos/backups
RSOS_BACKUP_RETENTION_DAYS=30

# TLS certificate material provisioned by hosting platform
RSOS_TLS_KEY_PATH=/etc/ssl/private/rsos.key
RSOS_TLS_CERT_PATH=/etc/ssl/certs/rsos.crt

# Frontend build output path
RSOS_FRONTEND_DIST=app/dist

# Operator-only health token (never expose publicly)
RSOS_OPERATOR_TOKEN=replace-with-strong-random-token

# Optional: allow absolute API base URLs instead of relative /api
RSOS_REQUIRE_ABSOLUTE_API_BASE=false
