# RSOS secure production deployment template
NODE_ENV=production

# Public HTTPS origin served to end users
RSOS_PUBLIC_ORIGIN=https://your-rsos-domain.example

# Secure gateway ports
RSOS_HTTPS_PORT=443
RSOS_HTTP_REDIRECT_PORT=80

# Internal backend binding for proxy-only access
RSOS_INTERNAL_API_PORT=3001
RSOS_BIND_HOST=127.0.0.1

# Persistent storage — REQUIRED on Railway; set to the volume mount path
# All business data, auth state, MFA state, and backups derive from these.
RSOS_DATA_DIR=/data/rsos/data
RSOS_BACKUP_DIR=/data/rsos/backups
RSOS_BACKUP_RETENTION_DAYS=30

# TLS certificate material provisioned by hosting platform
RSOS_TLS_KEY_PATH=/etc/ssl/private/rsos.key
RSOS_TLS_CERT_PATH=/etc/ssl/certs/rsos.crt

# Frontend build output path
RSOS_FRONTEND_DIST=app/dist

# Operator-only health token (never expose publicly)
RSOS_OPERATOR_TOKEN=replace-with-strong-random-token

# Administrator bootstrap credentials (required on first start or reset — never commit real values)
RSOS_ADMIN_USERNAME=replace-with-admin-email
RSOS_ADMIN_PASSWORD=replace-with-strong-admin-password

# Optional: allow absolute API base URLs instead of relative /api
RSOS_REQUIRE_ABSOLUTE_API_BASE=false
# Optional Comp Evidence Engine sources. Configure only licensed/authorized endpoints.
RSOS_COUNTY_ASSESSOR_BASE_URL=
RSOS_COUNTY_ASSESSOR_API_KEY=
RSOS_COUNTY_RECORDER_BASE_URL=
RSOS_COUNTY_RECORDER_API_KEY=
RSOS_PERMIT_RECORDS_BASE_URL=
RSOS_PERMIT_RECORDS_API_KEY=
RSOS_GOOGLE_MAPS_BASE_URL=
RSOS_GOOGLE_MAPS_API_KEY=
COMP_EVIDENCE_CACHE_TTL_MS=604800000
