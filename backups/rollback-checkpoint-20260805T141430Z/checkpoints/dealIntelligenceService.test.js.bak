import test from 'node:test';
import assert from 'node:assert/strict';
import { buildDealIntelligenceFromDeals, getStoredOrGeneratedDealIntelligence } from './dealIntelligenceService.js';

test('buildDealIntelligenceFromDeals creates entries from existing deals', () => {
  const result = buildDealIntelligenceFromDeals([
    {
      id: 'deal-1',
      propertyAddress: '123 Main St',
      city: 'Cincinnati',
      state: 'OH',
      zipCode: '45202',
      purchasePrice: 150000,
      rehabBudget: 40000,
      estimatedArv: 275000,
      estimatedRent: 2600,
      strategy: 'buy',
      status: 'active',
    },
  ]);

  assert.equal(result.length, 1);
  assert.equal(result[0].propertyName, '123 Main St');
  assert.equal(result[0].recommendation, 'Buy');
  assert.equal(result[0].analysisStatus, 'Ready');
  assert.ok(result[0].dealScore > 0);
});

test('returns existing populated intelligence without regeneration', async () => {
  const stored = [{ id: 'stored-1', propertyName: 'Existing', analysisStatus: 'Ready' }];
  const result = await getStoredOrGeneratedDealIntelligence(stored, [{ id: 'deal-1' }]);

  assert.equal(result.length, 1);
  assert.equal(result[0].id, 'stored-1');
});

test('regenerates intelligence from saved deals when stored intelligence is empty', async () => {
  const result = await getStoredOrGeneratedDealIntelligence([], [{ id: 'deal-1', propertyAddress: '123 Main St', purchasePrice: 100000, rehabBudget: 20000, estimatedArv: 180000, estimatedRent: 1800 }]);

  assert.equal(result.length, 1);
  assert.equal(result[0].propertyName, '123 Main St');
});

test('returns an empty array when there are no saved deals', async () => {
  const result = await getStoredOrGeneratedDealIntelligence([], []);

  assert.deepEqual(result, []);
});

test('buildDealIntelligenceFromDeals derives underwriting, offer guidance, and risk metrics from live deal inputs', () => {
  const result = buildDealIntelligenceFromDeals([
    {
      id: 'deal-2',
      propertyAddress: '456 Oak Ave',
      city: 'Cleveland',
      state: 'OH',
      zipCode: '44114',
      propertyType: 'Single Family',
      purchasePrice: 140000,
      rehabBudget: 35000,
      estimatedArv: 260000,
      estimatedRent: 2200,
      holdingMonths: 6,
      taxes: 1800,
      insurance: 900,
      financingCosts: 5000,
      closingCosts: 6000,
      strategy: 'flip',
    },
  ]);

  const intelligence = result[0];
  assert.equal(intelligence.propertyName, '456 Oak Ave');
  assert.equal(intelligence.buyBoxResult, 'PASS');
  assert.ok(intelligence.arvConfidenceScore > 0);
  assert.ok(intelligence.recommendedOffer > 0);
  assert.ok(intelligence.maximumAllowableOffer > 0);
  assert.ok(intelligence.maximumAllowableOffer >= intelligence.recommendedOffer);
  assert.ok(intelligence.underwritingSummary.includes('ARV'));
  assert.ok(intelligence.offerGuidance.includes('Offer'));
  assert.ok(Array.isArray(intelligence.majorRiskFlags));
  assert.ok(Array.isArray(intelligence.requiredFollowUpItems));
});

test('regenerates intelligence when stored intelligence is malformed', async () => {
  const result = await getStoredOrGeneratedDealIntelligence('not-an-array', [{ id: 'deal-1', propertyAddress: 'Malformed', purchasePrice: 100000, rehabBudget: 20000, estimatedArv: 180000, estimatedRent: 1800 }]);

  assert.equal(result.length, 1);
  assert.equal(result[0].propertyName, 'Malformed');
});

test('buildDealIntelligenceFromDeals persists investment decision, exit strategy, and risk profile fields', () => {
  const result = buildDealIntelligenceFromDeals([
    {
      id: 'deal-3',
      propertyAddress: '789 Pine Rd',
      city: 'Lexington',
      state: 'KY',
      zipCode: '40503',
      purchasePrice: 170000,
      rehabBudget: 45000,
      estimatedArv: 290000,
      estimatedRent: 2800,
      strategy: 'flip',
    },
  ]);

  const intelligence = result[0];
  assert.ok(intelligence.investmentDecision);
  assert.ok(intelligence.exitStrategy);
  assert.ok(intelligence.riskProfile);
  assert.ok(Array.isArray(intelligence.exitStrategy.rankedStrategies));
  assert.ok(Array.isArray(intelligence.riskProfile.recommendedNextActions));
});

test('buildDealIntelligenceFromDeals uses normalized underwriting for the Goss calibration deal', () => {
  const result = buildDealIntelligenceFromDeals([
    {
      id: 'deal-4',
      propertyAddress: '952 Goss Rd',
      city: 'Cincinnati',
      state: 'OH',
      zipCode: '45245',
      purchasePrice: '135000',
      rehabBudget: '60000',
      estimatedArv: '300000',
      annualTaxes: '2800',
      annualInsurance: '1200',
      holdingMonths: '4',
      actualLoanAmount: '182330',
      annualInterestRate: '11.24',
      cashToClose: '26857.90',
      earnestMoney: '3500',
      totalInitialCashInvested: '30357.90',
      constructionHoldback: '62990',
      exitStrategy: 'Flip',
      sellingCostPercent: '8',
      sellerConcessions: '0',
      fixedSaleCosts: '0',
      paymentType: 'Interest Only',
    },
  ]);

  const intelligence = result[0];
  assert.equal(intelligence.purchasePrice, 135000);
  assert.ok(Math.abs(intelligence.projectedProfit - 66004.07) < 1);
  assert.ok(Math.abs(intelligence.investmentDecision.monthlyCashFlow - 1707.82) < 1);
  assert.equal(intelligence.recommendation, intelligence.investmentDecision.recommendation);
  assert.ok(Math.abs(intelligence.investmentDecision.cashRequired - 90357.90) < 0.01);
});
